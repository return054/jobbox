{
  "manifest_version": 3,
  "name": "JobBox - 招聘岗位助手",
  "version": "0.1.0",
  "description": "一键保存招聘岗位并自动整理信息",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobBox"
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
